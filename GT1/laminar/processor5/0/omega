FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 7.5;

boundaryField
{
    top
    {
        type            omegaWallFunction;
        value           uniform 10000;
    }
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            zeroGradient;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    procBoundary5to3
    {
        type            processor;
        value           uniform 7.5;
    }
    procBoundary5to4
    {
        type            processor;
        value           uniform 7.5;
    }
    procBoundary5to7
    {
        type            processor;
        value           uniform 7.5;
    }
}


