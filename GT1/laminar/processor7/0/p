FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    top
    {
        type            zeroGradient;
    }
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    procBoundary7to4
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary7to5
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary7to6
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary7to14
    {
        type            processor;
        value           uniform 0;
    }
}


