FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.00015;

boundaryField
{
    top
    {
        type            kqRWallFunction;
        value           uniform 1e-12;
    }
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            zeroGradient;
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    procBoundary14to6
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary14to7
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary14to12
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary14to13
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary14to15
    {
        type            processor;
        value           uniform 0.00015;
    }
}


