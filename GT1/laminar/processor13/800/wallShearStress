FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "800";
    object      wallShearStress;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    top
    {
        type            calculated;
        value           nonuniform List<vector> 0();
    }
    inlet
    {
        type            calculated;
        value           nonuniform List<vector> 0();
    }
    outlet
    {
        type            calculated;
        value           nonuniform List<vector> 0();
    }
    front
    {
        type            wedge;
    }
    back
    {
        type            wedge;
    }
    procBoundary13to10
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary13to12
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary13to14
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary13to15
    {
        type            processor;
        value           uniform (0 0 0);
    }
}


