FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-12;

boundaryField
{
    top
    {
        type            nutUSpaldingWallFunction;
        value           uniform 1e-12;
    }
    inlet
    {
        type            calculated;
        value           nonuniform List<scalar> 
0
;
    }
    outlet
    {
        type            calculated;
        value           nonuniform List<scalar> 
0
;
    }
    bottom
    {
        type            symmetry;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    procBoundary7to0
    {
        type            processor;
        value           uniform 1e-12;
    }
    procBoundary7to4
    {
        type            processor;
        value           uniform 1e-12;
    }
    procBoundary7to5
    {
        type            processor;
        value           uniform 1e-12;
    }
    procBoundary7to6
    {
        type            processor;
        value           uniform 1e-12;
    }
}


