FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.00015;

boundaryField
{
    top
    {
        type            kqRWallFunction;
        value           uniform 1e-12;
    }
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 
0
;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottom
    {
        type            symmetry;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    procBoundary15to1
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary15to12
    {
        type            processor;
        value           uniform 0.00015;
    }
    procBoundary15to14
    {
        type            processor;
        value           uniform 0.00015;
    }
}


