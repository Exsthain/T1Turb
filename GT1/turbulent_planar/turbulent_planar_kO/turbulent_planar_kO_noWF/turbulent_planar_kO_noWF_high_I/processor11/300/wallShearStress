    top
    {
        type            calculated;
        value           nonuniform List<vector> 
0
;
    }
    inlet
    {
        type            calculated;
        value           nonuniform List<vector> 
0
;
    }
    outlet
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    bottom
    {
        type            symmetry;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    procBoundary11to9
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary11to10
    {
        type            processor;
        value           uniform (0 0 0);
    }
