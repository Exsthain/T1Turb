FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 7.5;

boundaryField
{
    top
    {
        type            fixedValue;
        value           nonuniform List<scalar> 
0
;
    }
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 
0
;
    }
    outlet
    {
        type            zeroGradient;
    }
    bottom
    {
        type            symmetry;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    procBoundary3to1
    {
        type            processor;
        value           uniform 7.5;
    }
    procBoundary3to2
    {
        type            processor;
        value           uniform 7.5;
    }
}


