FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "800";
    object      yPlus;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    top
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    slipsurface
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    bottom
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    frontandback
    {
        type            empty;
    }
    procBoundary4to1
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary4to3
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary4to5
    {
        type            processor;
        value           uniform 0;
    }
    procBoundary4to7
    {
        type            processor;
        value           uniform 0;
    }
}


