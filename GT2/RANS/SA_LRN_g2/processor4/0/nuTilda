FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 2e-06;

boundaryField
{
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    slipsurface
    {
        type            slip;
    }
    bottom
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    procBoundary4to0
    {
        type            processor;
        value           uniform 2e-06;
    }
    procBoundary4to2
    {
        type            processor;
        value           uniform 2e-06;
    }
    procBoundary4to5
    {
        type            processor;
        value           uniform 2e-06;
    }
    procBoundary4to6
    {
        type            processor;
        value           uniform 2e-06;
    }
    procBoundary4to9
    {
        type            processor;
        value           uniform 2e-06;
    }
}


