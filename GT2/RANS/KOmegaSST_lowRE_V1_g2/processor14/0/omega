FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 750;

boundaryField
{
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 750;
    }
    outlet
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    slipsurface
    {
        type            slip;
    }
    bottom
    {
        type            omegaWallFunction;
        value           nonuniform List<scalar> 0();
    }
    procBoundary14to12
    {
        type            processor;
        value           uniform 750;
    }
    procBoundary14to13
    {
        type            processor;
        value           uniform 750;
    }
    procBoundary14to15
    {
        type            processor;
        value           uniform 750;
    }
}


