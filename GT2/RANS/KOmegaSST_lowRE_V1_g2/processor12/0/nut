FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 2e-07;

boundaryField
{
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
    inlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    top
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    slipsurface
    {
        type            slip;
    }
    bottom
    {
        type            nutkWallFunction;
        value           nonuniform List<scalar> 0();
    }
    procBoundary12to7
    {
        type            processor;
        value           uniform 2e-07;
    }
    procBoundary12to9
    {
        type            processor;
        value           uniform 2e-07;
    }
    procBoundary12to11
    {
        type            processor;
        value           uniform 2e-07;
    }
    procBoundary12to13
    {
        type            processor;
        value           uniform 2e-07;
    }
    procBoundary12to14
    {
        type            processor;
        value           uniform 2e-07;
    }
    procBoundary12to15
    {
        type            processor;
        value           uniform 2e-07;
    }
}


