FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    slipsurface
    {
        type            slip;
    }
    bottom
    {
        type            epsilonWallFunction;
        value           uniform 0.01;
    }
    frontandback
    {
        type            empty;
    }
    procBoundary10to8
    {
        type            processor;
        value           uniform 0.01;
    }
    procBoundary10to9
    {
        type            processor;
        value           uniform 0.01;
    }
    procBoundary10to11
    {
        type            processor;
        value           uniform 0.01;
    }
    procBoundary10to12
    {
        type            processor;
        value           uniform 0.01;
    }
    procBoundary10to14
    {
        type            processor;
        value           uniform 0.01;
    }
}


