FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "900";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 2.220446e-16;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    top
    {
        type            zeroGradient;
    }
    outlet
    {
        type            zeroGradient;
    }
    slipsurface
    {
        type            slip;
    }
    bottom
    {
        type            kqRWallFunction;
        value           nonuniform List<scalar> 0();
    }
    frontandback
    {
        type            empty;
    }
    procBoundary9to8
    {
        type            processor;
        value           uniform 2.220446e-16;
    }
    procBoundary9to10
    {
        type            processor;
        value           uniform 2.220446e-16;
    }
    procBoundary9to14
    {
        type            processor;
        value           uniform 2.220446e-16;
    }
    procBoundary9to15
    {
        type            processor;
        value           uniform 2.220446e-16;
    }
}


